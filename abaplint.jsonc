{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/open-abap/open-abap-ci",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/open-abap/open-abap-gui",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": {
      "release": "open-abap",
      "language": "Normal"
    },
    "errorNamespace": "."
  },
  "rules": {
    "indentation": true,
    "unnecessary_return": true,
    "redundant_conversion": true,
    "xml_bom": true,
    "final_newline": true,
    "7bit_ascii": false, // todo
    "redundant_cast": true,
    "modify_only_own_db_tables": true,
    "form_tables_obsolete": true,
    "fm_global_parameters_obsolete": true,
    "msag_consistency": true,
    "max_one_method_parameter_per_line": false, // todo
    "max_one_statement": true,
    "abapdoc": false,
    "add_test_attributes": true,
    "aff_and_xml": true,
    "align_parameters": true,
    "align_type_expressions": true,
    "functional_writing": true,
    "ambiguous_statement": true,
    "keep_single_parameter_on_one_line": true,
    "many_parentheses": true,
    "catch_and_raise": true,
    "begin_single_include": true,
    "check_abstract": true,
    "whitespace_end": true,
    "when_others_last": true,
    "sort_empty_key": true,
    "contains_tab": true,
    "dangerous_statement": true,
    "cds_comment_style": true,
    "empty_line_in_statement": true,
    "empty_statement": true,
    "empty_structure": false, // todo
    "abapdoc_html_tag": false,
    "abapdoc_leading_at": false,
    "abapdoc_parameter_names": false,
    "call_transaction_authority_check": true,
    "cds_association_name": true,
    "cds_check_syntax": true,
    "cds_field_order": true,
    "cds_legacy_view": true,
    "cds_naming": true,
    "chain_mainly_declarations": true,
    "align_pseudo_comments": true,
    "allowed_object_types": false,
    "avoid_use": true,
    "change_if_to_case": false,
    "changing_sorted_line": true,
    "check_comments": false,
    "fully_type_constants": true,
    "fully_type_itabs": true,
    "invalid_table_index": true,
    "no_aliases": true,
    "names_no_dash": true,
    "keyword_case": true,
    "no_exclamation_escape": true,
    "select_add_order_by": true,
    "check_subrc": false,
    "check_text_elements": true,
    "class_attribute_names": false,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": false,
    "colon_missing_space": true,
    "commented_code": true,
    "constant_classes": true,
    "double_space": true,
    "downport": false,
    "newline_between_methods": true,
    "exporting": true,
    "identical_conditions": true,
    "constructor_visibility_public": true,
    "cyclic_oo": false,
    "cyclomatic_complexity": false,
    "db_operation_in_loop": true,
    "definitions_top": false,
    "delete_index_in_loop": true,
    "description_empty": true,
    "begin_end_names": true,
    "cds_parser_error": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "allowed_object_naming": true,
    "check_transformation_exists": true,
    "dynpro_checks": true,
    "global_class": true,
    "identical_form_names": true,
    "implement_methods": true,
    "local_testclass_consistency": true,
    "message_exists": true,
    "method_implemented_twice": true,
    "mix_returning": true,
    "no_comments_between_methods": true,
    "parser_bad_exceptions": true,
    "parser_error": true,
    "parser_missing_space": true,
    "sql_escape_host_variables": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}