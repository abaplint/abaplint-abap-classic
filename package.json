{
  "name": "@abaplint/morph2",
  "private": true,
  "version": "0.0.0",
  "description": "ABAPiti transpilation experiments for @abaplint/core",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "abapiti": "node scripts/call-abapiti.mjs && node scripts/abapgit-xml.mjs && node scripts/checks.mjs && abaplint --fix",
    "transpile": "abap_transpile",
    "unit": "abap_transpile && node transpiled/index.mjs",
    "test": "npm run abapiti && abaplint"
  },
  "devDependencies": {
    "@abaplint/cli": "^2.120.78",
    "@abaplint/runtime": "^2.14.6",
    "@abaplint/transpiler-cli": "^2.14.6"
  }
}
