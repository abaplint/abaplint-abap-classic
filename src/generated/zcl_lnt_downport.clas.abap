  METHOD get_metadata.
    DATA t1 TYPE REF TO zcl_lnt_irule_metadata.
    DATA t8 TYPE REF TO zlnt_runtime_opti_4ba3bdccd169.
    DATA(t11) = |Much like the 'commented_code' rule this rule loops through |.
    t11 = t11 && |unknown statements and tries parsing with\na higher level lan|.
    t11 = t11 && |guage version. If successful, various rules are applied to d|.
    t11 = t11 && |ownport the statement.\nTarget downport version is always v70|.
    t11 = t11 && |2, thus rule is only enabled if target version is v702.\n\nCur|.
    t11 = t11 && |rent rules:\n* NEW transformed to CREATE OBJECT, opposite of |.
    t11 = t11 && |https://rules.abaplint.org/use_new/\n* DATA() definitions are|.
    t11 = t11 && | outlined, opposite of https://rules.abaplint.org/prefer_inl|.
    t11 = t11 && |ine/\n* FIELD-SYMBOL() definitions are outlined\n* CONV is out|.
    t11 = t11 && |lined\n* COND is outlined\n* REDUCE is outlined\n* SWITCH is ou|.
    t11 = t11 && |tlined\n* FILTER is outlined\n* APPEND expression is outlined\n|.
    t11 = t11 && |* INSERT expression is outlined\n* EMPTY KEY is changed to DE|.
