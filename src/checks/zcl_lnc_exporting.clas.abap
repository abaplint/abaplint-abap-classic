* abaplint rule exporting, generated by scripts/checks.mjs
CLASS zcl_lnc_exporting DEFINITION PUBLIC INHERITING FROM cl_ci_test_root CREATE PUBLIC.
  PUBLIC SECTION.
    CONSTANTS c_rule TYPE string VALUE `exporting`.
    METHODS constructor.
ENDCLASS.

CLASS zcl_lnc_exporting IMPLEMENTATION.
  METHOD constructor.
    super->constructor( ).
    myname = 'ZCL_LNC_EXPORTING'.
    description = `abaplint - EXPORTING can be omitted`.
    category = 'ZCL_LNT_CATEGORY'.
    LOOP AT zcl_lnt_utils=>object_types( ) INTO DATA(lv_type).
      add_obj_type( lv_type ).
    ENDLOOP.
  ENDMETHOD.
ENDCLASS.
