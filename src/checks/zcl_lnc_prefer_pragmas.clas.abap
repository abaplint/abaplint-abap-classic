* abaplint rule prefer_pragmas, generated by scripts/checks.mjs
CLASS zcl_lnc_prefer_pragmas DEFINITION PUBLIC INHERITING FROM cl_ci_test_root CREATE PUBLIC.
  PUBLIC SECTION.
    CONSTANTS c_rule TYPE string VALUE `prefer_pragmas`.
    METHODS constructor.
ENDCLASS.

CLASS zcl_lnc_prefer_pragmas IMPLEMENTATION.
  METHOD constructor.
    super->constructor( ).
    myname = 'ZCL_LNC_PREFER_PRAGMAS'.
    description = `abaplint - prefer pragmas over pseudo comments`.
    category = 'ZCL_LNT_CATEGORY'.
    LOOP AT zcl_lnt_utils=>object_types( ) INTO DATA(lv_type).
      add_obj_type( lv_type ).
    ENDLOOP.
  ENDMETHOD.
ENDCLASS.
