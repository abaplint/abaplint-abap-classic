    super->constructor( ).
    myname = 'ZCL_LNC_CLOUD_TYPES'.
    description = `abaplint - Check cloud types`.
    category = 'ZCL_LNT_CATEGORY'.
    LOOP AT zcl_lnt_utils=>object_types( ) INTO DATA(lv_type).
      add_obj_type( lv_type ).
    ENDLOOP.
  ENDMETHOD.
ENDCLASS.
