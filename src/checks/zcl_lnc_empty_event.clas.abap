* abaplint rule empty_event, generated by scripts/checks.mjs
CLASS zcl_lnc_empty_event DEFINITION PUBLIC INHERITING FROM cl_ci_test_root CREATE PUBLIC.
  PUBLIC SECTION.
    CONSTANTS c_rule TYPE string VALUE `empty_event`.
    METHODS constructor.
    METHODS run REDEFINITION.
    METHODS if_ci_test~display_documentation REDEFINITION.
ENDCLASS.

CLASS zcl_lnc_empty_event IMPLEMENTATION.
  METHOD constructor.
    super->constructor( ).
    myname = 'ZCL_LNC_EMPTY_EVENT'.
    description = `abaplint - Empty selection screen or list processing event block`.
    category = 'ZCL_LNT_CATEGORY'.
    has_documentation = abap_true.
    LOOP AT zcl_lnt_utils=>object_types( ) INTO DATA(lv_type).
      add_obj_type( lv_type ).
    ENDLOOP.
    zcl_lnt_utils=>add_scimessages(
      EXPORTING
        iv_test        = myname
      CHANGING
        ct_scimessages = scimessages ).
  ENDMETHOD.

  METHOD run.
    LOOP AT zcl_lnt_utils=>run_rule(
        io_rule        = NEW zcl_lnt_empty_event( )
        iv_object_type = object_type
        iv_object_name = object_name ) INTO DATA(ls_finding).
      inform( p_sub_obj_type = c_type_include
              p_sub_obj_name = ls_finding-include
              p_line         = ls_finding-line
              p_column       = ls_finding-column
              p_kind         = ls_finding-kind
              p_test         = myname
              p_code         = ls_finding-code
              p_param_1      = ls_finding-text ).
    ENDLOOP.
  ENDMETHOD.

  METHOD if_ci_test~display_documentation.
    zcl_lnt_utils=>display_documentation( c_rule ).
  ENDMETHOD.
ENDCLASS.
