* abaplint rule nesting, generated by scripts/checks.mjs
CLASS zcl_lnc_nesting DEFINITION PUBLIC INHERITING FROM cl_ci_test_root CREATE PUBLIC.
  PUBLIC SECTION.
    CONSTANTS c_rule TYPE string VALUE `nesting`.
    METHODS constructor.
ENDCLASS.

CLASS zcl_lnc_nesting IMPLEMENTATION.
  METHOD constructor.
    super->constructor( ).
    myname = 'ZCL_LNC_NESTING'.
    description = `abaplint - Check nesting depth`.
    category = 'ZCL_LNT_CATEGORY'.
    LOOP AT zcl_lnt_utils=>object_types( ) INTO DATA(lv_type).
      add_obj_type( lv_type ).
    ENDLOOP.
  ENDMETHOD.
ENDCLASS.
